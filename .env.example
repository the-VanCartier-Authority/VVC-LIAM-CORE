# GEMINI_API_KEY: Optional Gemini AI fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA Build NIM models (e.g. nemotron-3.5-lightning, deepseek, glm, etc.).
# Get key from https://build.nvidia.com
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-managed OpenAI-compatible / NIM / Ollama / vLLM providers.
# Default NVIDIA and Gemini origins cannot be overridden by requests.
# Register full URLs; browser endpoint fields only select exact registered entries.
# See docs/recovery/F01-EGRESS.md for scoped local exceptions and dedicated key envs.
LLM_PROVIDERS_JSON='[]'
